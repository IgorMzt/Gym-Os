# -----------------------------------------------------------------------------
# Gym OS V6.9 — ambiente/runtime
# -----------------------------------------------------------------------------
APP_ENV=development
# local = processo atual da academia; cloud = backend central sem hardware local.
APP_ROLE=local
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Gere uma chave longa e aleatoria antes de producao.
SECRET_KEY=gere-uma-chave-aleatoria-longa
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Em producao atras de proxy/reverse proxy: TRUST_PROXY=1 e cookie seguro.
TRUST_PROXY=0
PROXY_HOPS=1
SESSION_COOKIE_SECURE=0

# Desenvolvimento local pode inicializar/migrar automaticamente.
# Em producao prefira 0 e execute: python manage.py init-db
AUTO_INIT_DB=1

# -----------------------------------------------------------------------------
# Persistencia
# -----------------------------------------------------------------------------
# V6.9 continua usando SQLite. PostgreSQL sera ativado na V6.10.
DATABASE_BACKEND=sqlite
SQLITE_PATH=
# Reservado para a V6.10. Nao coloque credenciais reais neste arquivo exemplo.
DATABASE_URL=

# V6.9 abstrai uploads, mas o backend efetivo ainda e local.
# Object storage sera ativado junto da infraestrutura cloud.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Vazio = apenas terminal/stdout. Em instalacao local pode apontar para uma pasta.
LOG_DIR=

# -----------------------------------------------------------------------------
# Agente local — canal preparado na V6.9; hardware real entra na V6.11
# -----------------------------------------------------------------------------
ENABLE_LOCAL_HARDWARE=1
AGENT_API_TOKEN=gere-um-token-aleatorio-longo
AGENT_SERVER_URL=http://127.0.0.1:5000
AGENT_ID=academia-principal
AGENT_HEARTBEAT_SECONDS=30

# -----------------------------------------------------------------------------
# Asaas Sandbox
# -----------------------------------------------------------------------------
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=cole-sua-chave-sandbox-aqui
ASAAS_WEBHOOK_TOKEN=gere-um-token-aleatorio-de-32-ou-mais-caracteres

# -----------------------------------------------------------------------------
# API mobile
# -----------------------------------------------------------------------------
MOBILE_ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
