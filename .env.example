# -----------------------------------------------------------------------------
# Gym OS V6.11 — ambiente/runtime
# -----------------------------------------------------------------------------
APP_ENV=development
# local = processo atual da academia; cloud = backend central sem hardware local.
APP_ROLE=local
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Gere uma chave longa e aleatoria antes de producao.
SECRET_KEY=gere-uma-chave-aleatoria-longa
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Em producao atras de proxy/reverse proxy: TRUST_PROXY=1 e cookie seguro.
TRUST_PROXY=0
PROXY_HOPS=1
SESSION_COOKIE_SECURE=0

# Desenvolvimento local pode inicializar/migrar automaticamente.
# Em producao prefira 0 e execute: python manage.py init-db
AUTO_INIT_DB=1

# -----------------------------------------------------------------------------
# Persistencia
# -----------------------------------------------------------------------------
# sqlite = desenvolvimento/local legado; postgresql = cloud/staging/producao.
DATABASE_BACKEND=sqlite
SQLITE_PATH=
# Exemplo local: postgresql://gymos:gymos_dev@127.0.0.1:5432/gymos
# Nao coloque credenciais reais neste arquivo exemplo.
DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=8
DATABASE_POOL_TIMEOUT=10
APP_TIMEZONE=America/Sao_Paulo

# V6.10 mantem uploads locais; object storage entra na V6.12 junto da camada de biometria.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Vazio = apenas terminal/stdout. Em instalacao local pode apontar para uma pasta.
LOG_DIR=

# -----------------------------------------------------------------------------
# Agente local — V6.11
# AGENT_API_TOKEN e o segredo de bootstrap usado apenas para registrar/rotacionar
# agentes. Depois do registro, cada maquina usa um token individual salvo no
# agent_state.db local.
# -----------------------------------------------------------------------------
ENABLE_LOCAL_HARDWARE=1
AGENT_API_TOKEN=gere-um-token-bootstrap-aleatorio-longo
AGENT_SERVER_URL=http://127.0.0.1:5000
AGENT_UID=academia-principal-pc01
AGENT_NAME=Entrada principal
AGENT_MACHINE_ID=
AGENT_STATE_PATH=
AGENT_HEARTBEAT_SECONDS=30
AGENT_SYNC_SECONDS=300
AGENT_REQUEST_TIMEOUT=8
AGENT_OFFLINE_CACHE_MAX_MINUTES=120

# -----------------------------------------------------------------------------
# Asaas Sandbox
# -----------------------------------------------------------------------------
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=cole-sua-chave-sandbox-aqui
ASAAS_WEBHOOK_TOKEN=gere-um-token-aleatorio-de-32-ou-mais-caracteres

# -----------------------------------------------------------------------------
# API mobile
# -----------------------------------------------------------------------------
MOBILE_ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
